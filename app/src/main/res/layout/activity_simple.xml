<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0A0E1A"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="J.A.R.V.I.S"
        android:textColor="#C0A855"
        android:textSize="36sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Just A Rather Very Intelligent System"
        android:textColor="#4A9EFF"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <View
        android:layout_width="200dp"
        android:layout_height="1dp"
        android:background="#2A3A55"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tv_status_simple"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Initializing..."
        android:textColor="#8899AA"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_test"
        android:layout_width="200dp"
        android:layout_height="52dp"
        android:text="ACTIVATE"
        android:textColor="#0A0E1A"
        android:textStyle="bold"
        android:backgroundTint="#C0A855" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Say Jarvis anytime to activate"
        android:textColor="#445566"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Long-press ACTIVATE for settings"
        android:textColor="#334455"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />

</LinearLayout>
