<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Jarvis" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/jarvis_gold</item>
        <item name="colorPrimaryVariant">@color/jarvis_blue</item>
        <item name="colorOnPrimary">@color/jarvis_bg</item>
        <item name="colorSurface">@color/jarvis_surface</item>
        <item name="colorOnSurface">@color/jarvis_text</item>
        <item name="android:windowBackground">@color/jarvis_bg</item>
        <item name="android:statusBarColor">@color/jarvis_surface</item>
        <item name="android:navigationBarColor">@color/jarvis_surface</item>
    </style>

    <style name="Theme.Jarvis.Splash" parent="Theme.Jarvis">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="JarvisDialogStyle" parent="Theme.MaterialComponents.Dialog">
        <item name="colorPrimary">@color/jarvis_gold</item>
        <item name="colorSurface">@color/jarvis_surface</item>
        <item name="colorOnSurface">@color/jarvis_text</item>
        <item name="android:textColorPrimary">@color/jarvis_text</item>
        <item name="android:background">@color/jarvis_surface</item>
    </style>

</resources>
